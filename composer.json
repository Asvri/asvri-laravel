{
    "name": "asvri/asvri-laravel",
    "description": "ASVRI for Laravel: take payments through every gateway you've connected to ASVRI, with a facade, a verified webhook route and Laravel events.",
    "type": "library",
    "keywords": ["asvri", "laravel", "payments", "checkout", "webhooks", "paystack", "flutterwave"],
    "homepage": "https://www.asvri.com/developers",
    "license": "MIT",
    "authors": [{ "name": "ASVRI", "homepage": "https://www.asvri.com" }],
    "support": {
        "issues": "https://github.com/asvri/asvri-laravel/issues",
        "source": "https://github.com/asvri/asvri-laravel",
        "docs": "https://www.asvri.com/developers/docs"
    },
    "require": {
        "php": "^8.2",
        "asvri/asvri-php": "^1.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": { "Asvri\\Laravel\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Asvri\\Laravel\\AsvriServiceProvider"],
            "aliases": { "Asvri": "Asvri\\Laravel\\Facades\\Asvri" }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
